{
  "name": "@neolorn/atlas-workspace",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || ^26.0.0",
    "pnpm": ">=11.1.2 <12"
  },
  "scripts": {
    "clean": "node ./tools/clean.mjs",
    "build": "pnpm run clean dist && pnpm run build:runtime && pnpm run build:toolkit",
    "build:runtime": "pnpm --filter @neolorn/atlas build",
    "build:toolkit": "pnpm --filter @neolorn/atlas-toolkit build",
    "generate:locale-profile": "node ./tools/generate-locale-profile.mjs",
    "generate:person-names": "node ./tools/generate-person-names.mjs",
    "generate:cli-options": "node ./tools/generate-cli-options.mjs",
    "generate:diagnostics-reference": "node ./tools/generate-diagnostics-reference.mjs",
    "generate:docs-reference": "node ./tools/generate-docs-reference.mjs",
    "verify:locale-profile": "node ./tools/generate-locale-profile.mjs --check",
    "verify:person-names": "node ./tools/generate-person-names.mjs --check",
    "verify:standards-sources": "node ./tools/verify-standards-sources.mjs",
    "verify:sterilize": "node ./tools/verify-sterilize.mjs",
    "verify:spec-links": "node ./tools/verify-spec-links.mjs",
    "verify:doc-links": "node ./tools/verify-doc-links.mjs",
    "test:toolkit": "vitest run --config vitest.toolkit.config.ts packages/toolkit/test",
    "test:runtime": "vitest run --config vitest.runtime.config.ts packages/runtime/test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:self-test": "node ./tools/verify-lint-self-test.mjs",
    "mutation": "stryker run",
    "lint": "eslint packages --max-warnings 0",
    "typecheck": "node ./tools/verify-typecheck.mjs",
    "verify:packages": "node ./tools/verify-package-structure.mjs",
    "verify:angular-free-consumer": "node ./tools/verify-angular-free-consumer.mjs",
    "verify:handler-derivation": "node ./tools/verify-handler-derivation.mjs",
    "verify:tarballs": "node ./tools/pack-verified.mjs dist/runtime && node ./tools/pack-verified.mjs dist/toolkit",
    "verify:export-surface": "node ./tools/verify-export-surface.mjs",
    "verify:cli-options": "node ./tools/generate-cli-options.mjs --check",
    "verify:diagnostics-reference": "node ./tools/generate-diagnostics-reference.mjs --check",
    "verify:docs-reference": "node ./tools/generate-docs-reference.mjs --check",
    "verify:guide-coverage": "node ./tools/verify-guide-coverage.mjs",
    "verify:doc-coverage": "node ./tools/verify-doc-coverage.mjs",
    "verify:angular-analysis": "node ./tools/verify-angular-analysis-public-api.mjs",
    "stage:node-runtimes": "node ./tools/stage-node-runtimes.mjs",
    "stage:consumer-store": "node ./tools/stage-consumer-store.mjs",
    "verify:node-compatibility": "node ./tools/verify-node-compatibility.mjs",
    "verify:platform": "node ./tools/verify-platform-capabilities.mjs",
    "refresh:consumer": "node ./tools/refresh-consumer-packages.mjs",
    "refresh:consumer-locks": "node ./tools/refresh-package-consumer-locks.mjs",
    "materialize:consumer": "node ./tools/materialize-package-consumer.mjs",
    "verify:consumer": "pnpm run materialize:consumer && node ./tools/verify-package-consumer.mjs",
    "verify:focused-consumers": "node ./tools/verify-focused-package-consumers.mjs",
    "materialize:angular-22.0.4": "node ./tools/materialize-package-consumer.mjs angular-22.0.4-consumer",
    "verify:angular-22.0.4": "pnpm run materialize:angular-22.0.4 && node ./tools/verify-package-consumer.mjs angular-22.0.4-consumer",
    "materialize:lower-bounds": "node ./tools/materialize-package-consumer.mjs lower-bounds-consumer",
    "verify:lower-bounds": "pnpm run materialize:lower-bounds && node ./tools/verify-package-consumer.mjs lower-bounds-consumer",
    "verify:consumer-refresh": "node ./tools/verify-consumer-refresh.mjs",
    "verify:cost-budget": "node --expose-gc ./tools/verify-cost-budget.mjs",
    "verify:cold-start": "node ./tools/verify-cold-start.mjs",
    "verify:document-blocks": "node ./tools/verify-document-blocks.mjs",
    "verify:message-format-conformance": "node ./tools/verify-message-format-conformance.mjs",
    "verify:message-function-space": "node ./tools/verify-message-function-space.mjs",
    "verify:assurance": "node ./tools/verify-assurance.mjs",
    "verify:assurance:runtime": "node ./tools/verify-assurance-runtime.mjs",
    "verify:browser-assurance:self-test": "node ./tools/verify-browser-assurance-self-test.mjs",
    "verify:browser-assurance": "node ./tools/verify-package-consumer-hydration.mjs",
    "verify": "node ./tools/verify.mjs",
    "verify:browser-assurance:angular-22.0.4": "node ./tools/verify-package-consumer-hydration.mjs angular-22.0.4-consumer",
    "verify:browser-assurance:lower-bounds": "node ./tools/verify-package-consumer-hydration.mjs lower-bounds-consumer",
    "verify:edit-cost": "node ./tools/verify-consumer-edit-cost.mjs"
  },
  "devDependencies": {
    "@angular/build": "22.1.7",
    "@angular/cli": "22.1.7",
    "@angular/common": "22.1.3",
    "@angular/compiler": "22.1.3",
    "@angular/compiler-cli": "22.1.3",
    "@angular/core": "22.1.3",
    "@angular/forms": "22.1.3",
    "@angular/platform-browser": "22.1.3",
    "@angular/platform-server": "22.1.3",
    "@angular/router": "22.1.3",
    "@angular/ssr": "22.1.7",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/node": "24.13.3",
    "cldr-core": "48.2.0",
    "cldr-localenames-full": "48.2.0",
    "eslint": "10.10.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "jsdom": "29.1.1",
    "ng-packagr": "22.1.1",
    "playwright": "1.61.1",
    "prettier": "3.8.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vitest": "4.1.10",
    "xmllint-wasm": "5.3.0"
  }
}
